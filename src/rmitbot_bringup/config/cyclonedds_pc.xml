<?xml version="1.0" encoding="UTF-8" ?>
<!--
    CycloneDDS Configuration for PC/Laptop
    
    This config enables direct peer discovery with the Raspberry Pi.
    No multicast required - uses unicast to the Pi's IP address.
    
    Usage:
        export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
        export CYCLONEDDS_URI=file:///path/to/cyclonedds_pc.xml
        ros2 launch rmitbot_bringup pc.launch.py
    
    IMPORTANT: Replace PI_IP_ADDRESS with your Raspberry Pi's actual IP
               (e.g., 192.168.1.10)
-->
<CycloneDDS xmlns="https://cdds.io/config">
    <Domain id="any">
        <General>
            <Interfaces>
                <!-- Use your network interface (run 'ip a' to find it) -->
                <!-- Common options: wlan0 (WiFi), eth0 (Ethernet), enp* -->
                <NetworkInterface name="wlan0" />
            </Interfaces>
            <AllowMulticast>true</AllowMulticast>
        </General>
        <Discovery>
            <ParticipantIndex>auto</ParticipantIndex>
            <Peers>
                <!-- Replace with your Raspberry Pi's IP address -->
                <Peer address="172.20.10.4"/>
            </Peers>
        </Discovery>
        <Internal>
            <MaxParticipants>120</MaxParticipants>
        </Internal>
        <SharedMemory>
            <Enable>false</Enable>
        </SharedMemory>
    </Domain>
</CycloneDDS>
